{
  "name": "@rallypoint/swarm-graph",
  "version": "0.1.0",
  "description": "Live force graph of a Rallypoint swarm: which agents work which sectors of the codebase, and how their effort flows to the integration branch.",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./model": "./src/model.ts",
    "./render": "./src/render.ts",
    "./replay": "./src/replay.ts",
    "./intro": "./src/intro.ts",
    "./effects": "./src/effects.ts",
    "./lifecycle": "./src/lifecycle.ts"
  },
  "sideEffects": false,
  "scripts": {
    "test": "tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "d3": "^7.9.0"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/node": "^22.20.5",
    "tsx": "^4.20.0",
    "typescript": "^5"
  }
}
